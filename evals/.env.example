# Isolated evals environment — never point this at production Oracle/DB.
APP_ENV=evals
EVALS_SUITE=deterministic

# Separate Postgres (docker compose in this folder)
DATABASE_URL=postgresql+asyncpg://loopp_evals:loopp_evals@localhost:5434/loopp_evals
EVALS_POSTGRES_PORT=5434

# Deterministic CI default
LLM_PROVIDER=mock
LLM_MODEL=mock-support
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMS=384
SESSION_SECRET=evals-only-secret

# Live / voice suite (manual): set LLM_PROVIDER=groq and a real key via shell, not committed files
# GROQ_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# VOICE_BACKEND=local
# VOICE_TTS_VOICE=alba

DEMO_CUSTOMER_ID=cust_pro_001
AGENT_MAX_CYCLES=8
AGENT_TURN_TIMEOUT_SECONDS=90
