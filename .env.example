# --- App ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://129.80.125.203.sslip.io,https://loopp-proxy.saitejareddi1503.workers.dev

# --- Database ---
DATABASE_URL=postgresql+asyncpg://loopp:loopp@localhost:5432/loopp
POSTGRES_USER=loopp
POSTGRES_PASSWORD=loopp
POSTGRES_DB=loopp
# Host port mapped to container 5432 (change if local Postgres already uses 5432)
POSTGRES_PORT=5432

# --- LLM ---
# Providers: mock | groq | openai | anthropic
# mock = deterministic local agent for automated tests (no API key)
# groq = OpenAI-compatible Groq API (Phase 2 default)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_API_KEY=
ANTHROPIC_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0

# --- Embeddings / RAG ---
# hash = lightweight local vectors for tests; fastembed = stronger local semantic vectors
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMS=384
RAG_COSINE_THRESHOLD=0.28
RAG_TOP_K=5

# --- Agent ---
AGENT_MAX_CYCLES=8
AGENT_TURN_TIMEOUT_SECONDS=90

# --- Demo sandbox ---
DEMO_CUSTOMER_ID=cust_pro_001
DEMO_CUSTOMER_NAME=Alex Rivera
DEMO_CUSTOMER_EMAIL=alex.rivera@example.com
DEMO_TIER=Pro

# --- Voice (Phase 3) ---
# auto = try local Moonshine+Pocket+Silero, fall back to Groq Whisper STT / null TTS
# Oracle reviewer path for Moonshine: set VOICE_BACKEND=local (requires voice weights on the VM)
VOICE_BACKEND=auto
VOICE_INPUT_SAMPLE_RATE=16000
VOICE_VAD_THRESHOLD=0.5
VOICE_TTS_VOICE=alba

# --- Security ---
SESSION_SECRET=replace-with-long-random-string
SESSION_TTL_SECONDS=43200
