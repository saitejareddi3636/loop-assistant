{
	email saitejareddi1503@gmail.com
	servers {
		protocols h1 h2
	}
}

# HTTP: ACME + direct IP access (chat still works on http://IP)
:80 {
	encode gzip
	reverse_proxy api:8000 {
		header_up Host {host}
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}

# Publicly trusted HTTPS origin for Cloudflare Worker (Let's Encrypt via sslip.io)
https://129.80.125.203.sslip.io {
	encode gzip
	reverse_proxy api:8000 {
		header_up Host {host}
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}

# Direct-IP HTTPS is intentionally disabled.
# Serving a second HTTPS site on the same :443 with a self-signed cert for the
# bare IP caused TLS alerts for many clients (SNI / cert mismatch vs sslip.io).
# Public entrypoints:
#   - https://129.80.125.203.sslip.io  (Let's Encrypt origin)
#   - https://loopp-proxy.<subdomain>.workers.dev  (Cloudflare Worker)
# HTTP :80 above remains for ACME challenges and plain IP debugging.
